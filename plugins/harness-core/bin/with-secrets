#!/bin/bash
# with-secrets: give a command its API tokens at launch, without tokens in config files, git or argv.
#
#   with-secrets NAME [NAME...] -- command [args...]   resolve NAMEs into the env, then exec command
#   with-secrets --set NAME                            store a secret (prompts; value never on argv)
#   with-secrets --list                                list stored secret names (never values)
#   with-secrets --rm NAME                             delete a stored secret
#
# Lookup order for each NAME (first hit wins):
#   1. already set in the environment (CI, direnv, 1Password `op run`, ...)
#   2. OS secret store: macOS Keychain (service "agent-harness", account NAME)
#                       Linux libsecret via secret-tool (service agent-harness, account NAME)
#   3. ${AGENT_HARNESS_ENV:-~/.config/agent-harness/.env}   KEY=value lines; must be chmod 600
set -euo pipefail
SERVICE=agent-harness
ENVFILE=${AGENT_HARNESS_ENV:-$HOME/.config/agent-harness/.env}
die() { echo "with-secrets: $*" >&2; exit 1; }
mac() { [ "$(uname)" = Darwin ]; }

store_get() {
  if mac; then security find-generic-password -s "$SERVICE" -a "$1" -w 2>/dev/null || true
  elif command -v secret-tool >/dev/null; then secret-tool lookup service "$SERVICE" account "$1" 2>/dev/null || true
  fi
}
file_get() {
  [ -f "$ENVFILE" ] || return 0
  if [ "$(stat -f %Lp "$ENVFILE" 2>/dev/null || stat -c %a "$ENVFILE")" != 600 ]; then
    die "$ENVFILE must be chmod 600"
  fi
  grep -E "^(export )?$1=" "$ENVFILE" | tail -1 | cut -d= -f2- | sed -E "s/^[\"']//; s/[\"']$//"
}

case "${1:-}" in
  --set)
    [ -n "${2:-}" ] || die "usage: with-secrets --set NAME"
    if mac; then security add-generic-password -U -s "$SERVICE" -a "$2" -w   # -w last = prompt
    else secret-tool store --label="$SERVICE $2" service "$SERVICE" account "$2"; fi
    echo "stored $2"; exit 0 ;;
  --rm)
    [ -n "${2:-}" ] || die "usage: with-secrets --rm NAME"
    if mac; then security delete-generic-password -s "$SERVICE" -a "$2" >/dev/null
    else secret-tool clear service "$SERVICE" account "$2"; fi
    echo "removed $2"; exit 0 ;;
  --list)
    if mac; then security dump-keychain 2>/dev/null | awk -v s="\"$SERVICE\"" '
        /"acct"<blob>=/ { a=$0; sub(/.*<blob>="/, "", a); sub(/"$/, "", a) }
        /"svce"<blob>=/ && index($0, s) { print a }' | sort -u
    else secret-tool search --all service "$SERVICE" 2>/dev/null | sed -n 's/^attribute.account = //p'; fi
    [ -f "$ENVFILE" ] && sed -nE 's/^(export )?([A-Za-z_][A-Za-z0-9_]*)=.*/\2 (env file)/p' "$ENVFILE"
    exit 0 ;;
  -h|--help|"") sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

names=()
while [ $# -gt 0 ] && [ "$1" != "--" ]; do names+=("$1"); shift; done
[ "${1:-}" = "--" ] || die "usage: with-secrets NAME... -- command [args...]"
shift
for n in "${names[@]}"; do
  [ -n "${!n:-}" ] && continue
  v=$(store_get "$n"); [ -n "$v" ] || v=$(file_get "$n")
  [ -n "$v" ] || die "$n not found (env, $SERVICE/$n in the OS secret store, $ENVFILE). Add it: with-secrets --set $n"
  export "$n=$v"
done
exec "$@"
